@top Program { compilationUnit }

@detectDelim

@precedence {
	namedArg,
	typeParams,
	typeArgs,
	typeAccess @left,
	typeUnary2 @left, typeUnary @left,
	else @right,
	cast,
	new,
	memberCall @left,
	memberAccess @left,
	elementAccess @left,
	varDecl @left,
	call @left,
	unary @left,
	range @left,
	switch @left
	with @left,
	mul_div @left,
	add_sub @left,
	shift_lr @left,
	compare @left,
	equality @left,
	and @left,
	xor @left,
	or @left,
	c_and @left,
	c_or @left,
	nullcoal @right,
	ternary @right,
	params,
	anonMethod,
	topLevelLocalFunc,
	arrow @right,
	assign @right,
	throw @left,
	q_into @right,
	comma @left
}

@external tokens interpString from './tokens' {
	interpStringContent,
	interpStringBrace,
	interpStringEnd
}

@external tokens interpVString from './tokens' {
	interpVStringContent,
	interpVStringBrace,
	interpVStringEnd
}

@external tokens rawString from './tokens' {
	rawStringStart,
	regularRawStringContent,
	rawStringEnd
}

@external tokens interpRawString from './tokens' {
	interpRawStringStart,
	interpRawStringContent,
	interpRawStringBraceStart[@name='{'],
	interpRawStringBraceEnd[@name='}'],
	interpRawStringEnd
}

@context rawStringTracker from './tokens'

@external tokens docComment from './tokens' { DocComment }

@skip { newline | whitespace | DocComment | LineComment | BlockComment | PP_Directive }

@tokens {
	// Line terminators
	
	newline {
		$[\r\n\u0085\u2028\u2029]
		| '\r\n'
	}

	
	// Comments
	
	LineComment { '//' ![\r\n\u0085\u2028\u2029]* }

	BlockComment { '/*' (![\*] | '*' ![/])* '*/'? }

	// Whitespace
	
	whitespace { $[\t\u000b\u000c \u00a0\u1680\u2000-\u200a\u202a\u205f\u3000] }


	// General

	identifier { simpleIdentifier }

	letter {
		$[a-zA-Z_\u00A1-\u167F\u1681-\u1FFF\u200B-\u2027\u202B-\u202E\u2030-\u205E\u2060-\u2FFF\u3001-\u{10FFFF}]
	}

	simpleIdentifier {
		'@'?
		letter
		(@digit | letter)*
	}

	// Integer literals

	IntegerLiteral {
		decimalInteger
		| hexadecimalInteger
		| binaryInteger
	}

	decimalInteger { decimalDigit decoratedDigit<decimalDigit>* integerTypeSuffix? }

	decoratedDigit<digit> { '_'* digit }

	decimalDigit { @digit }

	integerTypeSuffix {
		'U' | 'u' | 'L' | 'l'
		| 'UL' | 'Ul' | 'uL' | 'ul' | 'LU' | 'Lu' | 'lU' | 'lu'
	}

	hexadecimalInteger { '0' $[xX] decoratedDigit<hexDigit>+ integerTypeSuffix? }

	hexDigit { $[0-9A-Fa-f] }
	
	binaryInteger { '0' $[bB] decoratedDigit<binaryDigit>+ integerTypeSuffix? }

	binaryDigit { $[01] }


	// Real literals

	RealLiteral {
		decimalDigit decoratedDigit<decimalDigit>* '.' decimalDigit decoratedDigit<decimalDigit>* exponentPart? realTypeSuffix?
		| '.' decimalDigit decoratedDigit<decimalDigit>* exponentPart? realTypeSuffix?
		| decimalDigit decoratedDigit<decimalDigit>* exponentPart realTypeSuffix?
		| decimalDigit decoratedDigit<decimalDigit>* realTypeSuffix
	}

	exponentPart { $[eE] $[+\-]? decimalDigit decoratedDigit<decimalDigit>* }

	realTypeSuffix { $[FfDdMm] }


	// Character literals

	CharacterLiteral { "'" character "'" }

	character {
		singleCharacter
		| simpleEscapeSequence
		| hexadecimalEscapeSequence
		| unicodeEscapeSequence
	}

	singleCharacter { !['\\\r\n\u0085\u2028\u2029] }

	simpleEscapeSequence { '\\' $['"\\0abfnrtv] }
	
	hexadecimalEscapeSequence { '\\x' hexDigit hexDigit? hexDigit? hexDigit? }

	unicodeEscapeSequence {
		'\\u' hexDigit hexDigit hexDigit hexDigit
		| '\\U' hexDigit hexDigit hexDigit hexDigit hexDigit hexDigit hexDigit hexDigit
	}


	// String literals

	StringLiteral[group=String] {
		regularString
		| verbatimString
	}

	utf8StringLiteralEnd[@name=Keyword] {
		('U8' | 'u8')
	}

	regularString { '"' regularStringCharacter* '"' }

	regularStringCharacter {
		singleRegularStringCharacter
		| simpleEscapeSequence
		| hexadecimalEscapeSequence
		| unicodeEscapeSequence
	}

	singleRegularStringCharacter { !["\\\r\n\u0085\u2028\u2029] }

	verbatimString { '@"' verbatimStringCharacter* '"' }

	verbatimStringCharacter {
		!["]
		| '""'
	}


	// Operators and punctuators

	'{' '}' '[' ']' '(' ')' ',' ';'
	'.'[group=Separator] '::'[group=Separator]
	'..'[group=Operator] ':'[group=Operator]
	'++'[group=Operator] '--'[group=Operator] '+'[group=Operator] '-'[group=Operator]
	'*'[@name=Astrisk, group=Operator] '/'[@name=Slash, group=Operator] '%'[group=Operator]
	'!'[@name=Not, group=Operator] '~'[group=Operator]
	'<<='[group=Operator] '<<'[group=Operator] '<='[group=Operator] '>='[group=Operator] '<'[group=Operator] '>'[group=Operator]
	'=='[group=Operator] '!='[@name=NotEq, group=Operator] '&&'[group=Operator] '||'[group=Operator] '&'[group=Operator] '|'[group=Operator] '^'[group=Operator]
	'??='[group=Operator] '??'[group=Operator] '?'[group=Operator]
	'='[group=Operator] '+='[group=Operator] '-='[group=Operator] '*='[group=Operator] '/='[@name=SlashEq, group=Operator] '%='[group=Operator] '&='[group=Operator] '|='[group=Operator] '^='[group=Operator]
	'->'[group=Operator] '=>'[group=Operator]
	'$"'[group=String] '@$"'[group=String] '$@"'[group=String]


	// General

	PP_Directive { pp_start pp_kind /*...*/ }

	// TODO: make this detect beginning of line
	pp_start {
		'#' whitespace*
	}

	pp_kind {
		pp_declaration
		| pp_conditional
		| pp_line
		| pp_diagnostic
		| pp_ignored
		| pp_region
		| pp_shebang
		| pp_pragma
		| pp_load
		| pp_nullable
		| pp_reference
		| pp_custom
	}

	pp_declaration {
		'define' whitespace+ identifier
		| 'undef' whitespace+ identifier
	}

	pp_conditional {
		'if' whitespace+ ![\n]+
		| 'elif' whitespace+ ![\n]+
		| 'else'
		| 'endif'
		}

	pp_diagnostic {
		'error' (whitespace+ ![\n]+)?
		| 'warning' (whitespace+ ![\n]+)?
	}

	pp_ignored {
		':' ![\n]+
	}

	pp_region {
		'region' (whitespace+ ![\n]+)?
		| 'endregion' (whitespace+ ![\n]+)?
	}

	pp_shebang {
		'!' ![\n]*
	}

	pp_line { 'line' whitespace+ ![\n]+ }

	pp_pragma { 'pragma' (whitespace+ ![\n]+)? }
	
	pp_load { 'load' (whitespace+ ![\n]+)? }
	
	pp_nullable { 'nullable' (whitespace+ ![\n]+)? }
	
	pp_reference { 'r' (whitespace+ ![\n]+)? }
	
	pp_custom { identifier (whitespace+ ![\n]+)? }

	// Precedence

	@precedence { utf8StringLiteralEnd, identifier }

	@precedence { RealLiteral, IntegerLiteral }

	@precedence { '..', RealLiteral, '.' }

	@precedence { LineComment, BlockComment, '/=', '/' }
}


// Keywords

new { kw<'new'> }

ref { kw<'ref'> }

scoped { kw<'scoped'> }

readonly { kw<'readonly'> }


// Boolean literals

BooleanLiteral {
	@specialize<identifier, 'true' | 'false'>
}


// The null literal

NullLiteral {
	@specialize<identifier, 'null'>
}


// Operators and punctuators

RightShift { '>' '>' }

RightShiftAssignment { '>' '>=' }


// General (Types)

TypeIdentifier { identifier ~tid }

namespaceName { namespaceOrTypeName }

typeName { namespaceOrTypeName }

namespaceOrTypeNameAccess {
	!typeAccess '.' TypeIdentifier typeArgumentList? namespaceOrTypeNameAccess
	| !typeAccess '.' TypeIdentifier typeArgumentList?
}

namespaceOrTypeName {
	TypeIdentifier typeArgumentList? namespaceOrTypeNameAccess?
	| QualifiedAliasMember namespaceOrTypeNameAccess?
}


type {
	(typeName | SimpleType | tupleType) (!typeUnary2 ~elementAccess rankSpecifier+ nullOrPtr? | nullOrPtr)?
}

nonArrayType {
	(typeName | SimpleType | tupleType) nullOrPtr?
}

nullOrPtr {
	!typeUnary '*'+
	| !typeUnary '?'
}

arrayType { nonArrayType !typeUnary2 rankSpecifier+ }

rankSpecifier { '[' ','* ']' }

SimpleType {
	@specialize<identifier
		, 'void'
		| 'sbyte'
		| 'byte'
		| 'short'
		| 'ushort'
		| 'int'
		| 'uint'
		| 'long'
		| 'ulong'
		| 'nint'
		| 'nuint'
		| 'char'
		| 'float'
		| 'double'
		| 'bool'
		| 'decimal'
		| 'string'
		| 'object'
		| 'dynamic'
	>
}

tupleType/*[@dynamicPrecedence=1]*/ {
	parens<~tuple csep1<(type VarName)>>
	| parens<~tuple type !comma ',' csep1<type>>
}


// Type arguments

typeArgumentList { !typeArgs chevrons<csep1<type>> }


// General (Literals)

UTF8StringLiteral[group=String] {
	StringLiteral utf8StringLiteralEnd
}

RawStringLiteral[group=String] {
	regularRawString
}

regularRawString { rawStringStart regularRawStringContent* rawStringEnd }

UTF8RawStringLiteral[group=String] {
	RawStringLiteral utf8StringLiteralEnd
}

literal {
	BooleanLiteral
	| IntegerLiteral
	| RealLiteral
	| kw<'__arglist'>
	| CharacterLiteral
	| StringLiteral
	| UTF8StringLiteral
	| RawStringLiteral
	| UTF8RawStringLiteral
	| NullLiteral
}


// General (Arguments)

arguments { parens<argumentList?> }

argumentList { csep1<argument> }

argument { ArgumentName? argumentValue }

ArgumentName { identifier ~id ':' }

argumentValue {
	expr
	| kw<'ref'> expr
	| kw<'in'> expr
	| kw<'out'> (scoped? localVarType)? VarName
}


// General (Expressions)

PrimaryExpr[group=Expression] {
	PrimaryNoArrayCreationExpr
	| ArrayCreationExpr
}

Ident/*[@dynamicPrecedence=1]*/ { identifier ~tid ~id }

PrimaryNoArrayCreationExpr[group=Expression] {
	literal
	| InterpolatedStringExpr
	| Ident
	| ParenOrTupleExpr
	| memberAccess
	| nullableMemberAccess
	| CallExpr
	| elementAccess
	| nullableElementAccess
	| thisAccess
	| baseAccess
	| PostIncrementExpr
	| PostDecrementExpr
	| NullCheckExpr
	| ObjectCreationExpr
	| AnonObjectCreationExpr
	| TypeofExpr
	| SizeofExpr
	| CheckedExpr
	| UncheckedExpr
	| DefaultValueExpr
	| FieldExpr
	| NameofExpr
	| SwitchExpr
	| WithExpr
	| AnonMethodExpr
	| pointerMemberAccess
	| stackallocInit
	| MakeRefExpr
	| RefTypeExpr
	| RefValueExpr
}


// Interpolated string expressions

InterpolatedStringExpr[group=Expression] {
	InterpolatedRegularString
	| InterpolatedVerbatimString
	| InterpolatedRawString
}

InterpolatedRegularString[group=String] { '$"' interpStringParts* interpStringEnd }

interpStringParts {
	interpStringContent
	| interpStringBrace expr (',' literal)? (':' identifier+)? '}'
}

InterpolatedVerbatimString[group=String] { ('$@"' | '@$"') interpVStringParts* interpVStringEnd }

interpVStringParts {
	interpVStringContent
	| interpVStringBrace expr (',' literal)? (':' identifier+)? '}'
}

InterpolatedRawString[group=String] { interpRawStringStart interpRawStringParts* interpRawStringEnd }

interpRawStringParts {
	interpRawStringContent
	| interpRawStringBraceStart expr (',' literal)? (':' identifier+)? interpRawStringBraceEnd
}


// Simple names

simpleName { identifier typeArgumentList? }


// Paren/Tuple expressions

ParenOrTupleExpr[@dynamicPrecedence=-1, group=Expression] { parens<~tuple csep1<ArgumentName? expr>> }


// Member access

memberAccess {
	PrimaryExpr !memberAccess '.' VarName
	| PrimaryExpr !memberAccess memberCall
	| SimpleType !memberAccess '.' VarName
	| SimpleType !memberAccess memberCall
	| QualifiedAliasMember !memberAccess '.' VarName
	| QualifiedAliasMember !memberAccess memberCall
}

memberCall { '.' MethodName typeArgumentList? !memberCall arguments }


nullableMemberAccess {
	PrimaryExpr !memberAccess '?' '.' VarName dependentAccess*
	| PrimaryExpr !memberAccess '?' memberCall dependentAccess*
}


dependentAccess {
	!memberAccess '.' VarName
	| memberCall
	| !elementAccess brackets<argumentList>
	| typeArgumentList? !call arguments
}


// Call expression

CallExpr[group=Expression] {
	MethodName typeArgumentList? !call arguments
	| PrimaryExpr typeArgumentList? !call arguments
}


// Element access

elementAccess {
	PrimaryNoArrayCreationExpr !elementAccess ~elementAccess brackets<argumentList>
}

nullableElementAccess {
	PrimaryNoArrayCreationExpr !elementAccess '?' brackets<argumentList> dependentAccess*
}


// This access

thisAccess { kw<'this'> }


// Base access

baseAccess {
	kw<'base'> !memberAccess '.' simpleName
	| kw<'base'> !elementAccess brackets<argumentList>
}


// Incr/decr operators

PostIncrementExpr[group=Expression] { PrimaryExpr !unary '++' }

PostDecrementExpr[group=Expression] { PrimaryExpr !unary '--' }

PreIncrementExpr[group=Expression] { !unary '++' PrimaryExpr }

PreDecrementExpr[group=Expression] { !unary '--' PrimaryExpr }


// Null-check expr

NullCheckExpr[group=Expression] { PrimaryExpr !unary '!' }


// Object creation expr

ObjectCreationExpr[group=Expression] {
	!new new nonArrayType? arguments objectOrCollectionInit?
	| !new new nonArrayType objectOrCollectionInit
}

objectOrCollectionInit { objectInit | collectionInit }


// Object initializers

objectInit {
	braces<csep1<memberInit>>
	| braces<csep0<memberInit> ','>
}

memberInit { InitializerTarget !assign '=' ref? initializerValue }

InitializerTarget[@dynamicPrecedence=1] {
	identifier ~id
	| brackets<argumentList>
}

initializerValue {
	nonAssignmentExpr
	| objectOrCollectionInit
}


// Collection initializers

collectionInit { braces<csep1<elementInit> ','?> }

elementInit {
	ref? nonAssignmentExpr
	| braces<csep1<(ref? expr)>>
}

exprList { csep1<expr> }


// Array creation expr

ArrayCreationExpr[group=Expression] {
	!new new nonArrayType brackets<exprList> rankSpecifier* arrayInit?
	| !new new arrayType arrayInit
	| !new new rankSpecifier arrayInit
}


// Anonymous object creation expr

AnonObjectCreationExpr[group=Expression] { !new new anonObjectInit }

anonObjectInit {
	braces<csep0<memberDeclarator>>
	| braces<csep1<memberDeclarator> ','>
}

memberDeclarator {
	simpleName
	| memberAccess
	| PrimaryExpr !memberAccess '?' '.' simpleName
	| baseAccess
	| identifier !assign '=' ref? expr
}


// The typeof operator

TypeofExpr[group=Expression] {
	kw<'typeof'> parens<( type | unboundTypeName )>
}

unboundTypeNameAccess {
	!typeAccess ('.' | '::') TypeIdentifier unboundTypeNameAccess
	| !typeArgs genericDimensionSpecifier unboundTypeNameAccess?
}

unboundTypeName { TypeIdentifier unboundTypeNameAccess }

genericDimensionSpecifier { !typeArgs chevrons<','*> }


// The sizeof operator

SizeofExpr[group=Expression] { kw<'sizeof'> parens<type> }


// The checked/unchecked operators

CheckedExpr[group=Expression] { kw<'checked'> parens<expr> }

UncheckedExpr[group=Expression] { kw<'unchecked'> parens<expr> }


// Default value expr

DefaultValueExpr[group=Expression] { kw<'default'> ~default parens<type> }


// Field expr

FieldExpr[group=Expression] { ckw<'field'> ~field }


// Nameof expr

NameofExpr[group=Expression] { kw<'nameof'> parens<namedEntity> }

namedEntity { namedEntityTarget ('.' simpleName)* }

namedEntityTarget {
	simpleName
	| kw<'this'>
	| kw<'base'>
	| SimpleType
	| QualifiedAliasMember
}


// Pointer member access

pointerMemberAccess {
	PrimaryExpr !memberAccess '->' VarName
	| PrimaryExpr !memberAccess pointerMemberCall
	| SimpleType !memberAccess '->' VarName
	| SimpleType !memberAccess pointerMemberCall
	| QualifiedAliasMember !memberAccess '->' VarName
	| QualifiedAliasMember !memberAccess pointerMemberCall
}

pointerMemberCall { '->' MethodName typeArgumentList? !memberCall arguments }


// Await expression

AwaitExpr[group=Expression] { !unary kw<'await'> expr }


// Switch expression

SwitchExpr[group=Expression] {
	PrimaryExpr !switch kw<'switch'>
	braces<csep0<switchExprBranch> ','?>
}

switchExprBranch { pattern (kw<'when'> expr)? !arrow '=>' expr }


// With expression

WithExpr[group=Expression] { PrimaryExpr !with kw<'with'> objectInit }


// Ref expression

MakeRefExpr[group=Expression] { kw<'__makeref'> parens<expr> }

RefTypeExpr[group=Expression] { kw<'__reftype'> parens<expr> }

RefValueExpr[group=Expression] { kw<'__refvalue'> parens<expr ',' type> }

// General

UnaryExpr[group=Expression] {
	!unary ('+' | '-' | '!' | '~' | '&' | '*' | '^') expr
	| PreIncrementExpr
	| PreDecrementExpr
	| Cast[@dynamicPrecedence=1] { parens<~tuple type> !cast expr }
	| AwaitExpr
	| !throw kw<'throw'> expr
}


BinaryExpr[group=Expression] {
	expr !mul_div ('*' | '/' | '%') expr
	| expr !add_sub ('+' | '-') expr
	| expr !shift_lr ('<<' | RightShift) expr
	| expr !compare ('<' | '>' | '<=' | '>=') expr
	| expr !compare kw<'as'> type
	| expr !compare kw<'is'> topPattern
	| expr !equality ('==' | '!=') expr
	| expr !and '&' expr
	| expr !xor '^' expr
	| expr !or '|' expr
	| expr !c_and '&&' expr
	| expr !c_or '||' expr
	| expr !nullcoal '??' expr
	| expr !ternary '?' expr ':' expr
}


RangeExpr[group=Expression] {
	!range '..' expr?
	| expr !range '..' expr?
}


// Lambda expr

LambdaExpr[@dynamicPrecedence=1, group=Expression] {
	(kw<'async'> | kw<'static'>)? type? anonFuncSignature !arrow '=>' anonFuncBody
}

AnonMethodExpr[group=Expression] {
	kw<'async'>? !anonMethod kw<'delegate'> explicitAnonFuncSignature? block
}

anonFuncSignature {
	explicitAnonFuncSignature | implicitAnonFuncSignature
}

explicitAnonFuncSignature { parens<csep0<explicitAnonFuncParam>> }

explicitAnonFuncParam { (kw<'ref'> | kw<'out'>)? type ParamName }

implicitAnonFuncSignature {
	parens<csep1<ParamName ~id>>
	| ParamName ~id
}

anonFuncBody { expr | block }


// Query expr

QueryExpr[group=Expression] { fromClause queryBody }

fromClause {
	ckw<'from'> type? identifier kw<'in'> expr
}

queryBody {
	queryBodyClauses? selectOrGroupClause queryContinuation?
}

queryBodyClauses {
	queryBodyClause
	| queryBodyClauses queryBodyClause
}

queryBodyClause {
	fromClause
	| letClause
	| whereClause
	| joinClause
	| orderbyClause
}

letClause { ckw<'let'> identifier !assign '=' expr }

whereClause { kw<'where'> expr }

joinClause {
	ckw<'join'> type? identifier
	kw<'in'> expr
	ckw<'on'> expr
	ckw<'equals'> expr
	(ckw<'into'> identifier)?
}

orderbyClause { ckw<'orderby'> csep1<ordering> }

ordering { expr orderingDirection }

orderingDirection { ckw<'ascending'> | ckw<'descending'> }

selectOrGroupClause { selectClause | groupClause }

selectClause { ckw<'select'> expr }

groupClause { ckw<'group'> expr ckw<'by'> expr }

queryContinuation { !q_into ckw<'into'> identifier queryBody }


// Expressions

assignment { (PrimaryExpr | UnaryExpr) !assign assignOp ref? expr }

assignOp {
	'=' | '+=' | '-=' | '*=' | '/=' | '%=' | '&=' | '|=' | '^=' | '<<='
	| RightShiftAssignment | '??='
}


expr { nonAssignmentExpr | assignment }

nonAssignmentExpr {
	PrimaryExpr
	| UnaryExpr
	| BinaryExpr
	| RangeExpr
	| LambdaExpr
	| QueryExpr
	| kw<'default'> ~default
}


// Patterns

/*topPatternType {
	
}

topPatternTupleType[@dynamicPrecedence=1] {
	'(' ~tuple topPatternType !comma ',' csep1<topPatternType> ')'
	}*/

/*
(typeName | SimpleType | TupleType) (!typeUnary2 ~elementAccess rankSpecifier+ nullOrPtr? | nullOrPtr)
*/

topPattern {
	pattern
	//| type
}

pattern {
	literal
	| sep1<Ident, !memberAccess '.'>
	| discard
	| varPattern
	| RelationalPattern
	| LogicalPattern
	| PropertyPattern
	| tuplePattern
	| ListPattern
}


discard { ckw<'_'> }


varPattern {
	kw<'var'> varDesignation
	| type // BUGGY!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
	 	PropertyPatternFields?
	 	varSimpleDesignation
}

varSimpleDesignation { !varDecl discard | !varDecl VarName }

varDesignation {
	varSimpleDesignation
	| parens<~tuple csep0<varDesignation>>
}


RelationalPattern {
	!unary ('<' | '>' | '<=' | '>=') pattern
}


LogicalPattern {
	!unary ckw<'not'> pattern
	| pattern !and ckw<'and'> pattern
	| pattern !or ckw<'or'> pattern
}


PropertyPattern {
	//(typeName | SimpleType | arrayType)?
	PropertyPatternFields
	varSimpleDesignation?
}

PropertyPatternFields { !new braces<(csep1<PropertyPatternField> ','?)?> }

PropertyPatternField { sep1<VarName, !memberAccess '.'> !assign ':' pattern }


tuplePattern/*[@dynamicPrecedence=2]*/ {
	(typeName | SimpleType)?
	parens<~tuple csep1<(ArgumentName? pattern)>> PropertyPatternFields?
	varSimpleDesignation?
}


ListPattern {
	brackets<(csep1<(slicePattern | pattern)> ','?)?>
	varSimpleDesignation?
}

slicePattern {
	'..' pattern?
}


// General (Statements)

stmt {
	LabeledStmt
	| DeclStmt
	| EmbeddedStmt
}

TopLevelStmt[group=Statement] {
	TopLevelLabeledStmt
	| TopLevelDeclStmt
	| EmbeddedStmt
}

EmbeddedStmt[group=Statement] {
	block
	| EmptyStmt
	| ExprStmt
	| SelectionStmt
	| IterationStmt
	| JumpStmt
	| TryStmt
	| CheckedStmt
	| UncheckedStmt
	| LockStmt
	| UsingStmt
	| YieldStmt
	| UnsafeStmt
	| FixedStmt
}


// Block

block { braces<stmtList?> }


// Statement list

stmtList { stmt+ }


// Empty statement

EmptyStmt[group=Statement] { ';' }


// Labeled statement

LabeledStmt[group=Statement] { identifier ':' stmt }

TopLevelLabeledStmt[group=Statement] { identifier ':' TopLevelStmt }


// Declaration statement

DeclStmt[group=Statement] {
	LocalVarDecl
	| LocalConstDecl
	| LocalFuncDecl
}

TopLevelDeclStmt[group=Statement] {
	TopLevelVarDecl
	| LocalConstDecl
	| TopLevelLocalFuncDecl
}


// Local variable declaration

LocalVarDecl[group=Declaration] {
	varRefModifier kw<'var'> csep1<varDeclarator>
	| varRefModifier type csep1<varDeclarator>
	| kw<'var'> varDesignation !assign '=' expr
	| kw<'var'> csep1<varDeclarator>
	// BUGGY!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
	//| type !varDecl varDesignation !assign '=' expr
	| type !varDecl csep1<varDeclarator>
}

TopLevelVarDecl[group=Declaration] {
	kw<'var'> varDesignation !assign '=' expr
	| kw<'var'> csep1<varDeclarator>
	| type !varDecl csep1<varDeclarator>
}

varRefModifier {
	scoped refReadonly?
	| refReadonly
}

refReadonly {
	readonly ref readonly
	| readonly ref
	| ref readonly
	| ref ~ref
}

localVarType { type | kw<'var'> }

VarName { identifier ~tid }

varDeclarator { VarName (!assign '=' ref? varInit)? }

varInit {
	expr
	| arrayInit
}


// Local constant declaration

LocalConstDecl[group=Declaration] {
	kw<'const'> type csep1<constDeclarator>
}

ConstName { identifier ~tid }

constDeclarator { ConstName !assign '=' expr }


// Local function declaration

LocalFuncDecl[group=Declaration] { localFuncHeader localFuncBody }

localFuncHeader {
	(kw<'async'> | kw<'unsafe'> | kw<'safe'> | kw<'static'> | kw<'extern'>)*
	(ref ~ref)? type MethodName
	(!typeParams typeParamList)? !params formalParams
	typeParamConstraintsClause*
}

localFuncBody {
	block
	| '=>' ref? expr ';'
}

TopLevelLocalFuncDecl[group=Declaration] { attrs? topLevelLocalFuncHeader localFuncBody }

topLevelLocalFuncHeader {
	topLevelLocalFuncModifiers?
	(ref ~ref)? type MethodName
	(!typeParams typeParamList)? !params formalParams
	typeParamConstraintsClause*
}

topLevelLocalFuncModifiers {
	topLevelLocalFuncModifierHead topLevelLocalFuncModifier*
}

topLevelLocalFuncModifierHead {
	kw<'async'> !topLevelLocalFunc
	| kw<'unsafe'> !topLevelLocalFunc
	| kw<'safe'> !topLevelLocalFunc
	| kw<'static'> !topLevelLocalFunc
	| kw<'extern'> !topLevelLocalFunc
}

topLevelLocalFuncModifier {
	kw<'async'>
	| kw<'unsafe'>
	| kw<'safe'>
	| kw<'static'>
	| kw<'extern'>
}


// Expression statement

ExprStmt[group=Statement] { stmtExpr ';' }

stmtExpr {
	CallExprStmt
	| ObjectCreationExpr
	| assignment
	| PostIncrementExpr
	| PostDecrementExpr
	| PreIncrementExpr
	| PreDecrementExpr
	| AwaitExpr
}

CallExprStmt[group=Statement] {
	MethodName typeArgumentList? !call arguments
	| PrimaryExpr !memberAccess memberCall
	| PrimaryExpr typeArgumentList? !call arguments
}


// Selection statement

SelectionStmt[group=Statement] { IfStmt | SwitchStmt }


// If statement

IfStmt[group=Statement] {
	kw<'if'> parens<expr> EmbeddedStmt
	(!else kw<'else'> EmbeddedStmt)?
}


// Switch statement

SwitchStmt[group=Statement] { kw<'switch'> parens<expr> switchBlock }

switchBlock { braces<switchBodyStart?> }

switchBodyStart {
	kw<'case'> pattern (kw<'when'> expr)? ':' switchBody?
	| kw<'default'> ':' switchBody?
}

switchBody {
	kw<'case'> pattern (kw<'when'> expr)? ':' switchBody?
	| kw<'default'> ~default ':' stmt*
	| stmt switchBody?
}


// Iteration statement

IterationStmt[group=Statement] {
	WhileStmt
	| DoStmt
	| ForStmt
	| ForeachStmt
}


// While statement

WhileStmt[group=Statement] { kw<'while'> parens<expr> EmbeddedStmt }


// Do statement

DoStmt[group=Statement] { kw<'do'> EmbeddedStmt kw<'while'> parens<expr> ';' }


// For statement

ForStmt[group=Statement] {
	kw<'for'> parens<forInit? ';' expr? ';' forIter?> EmbeddedStmt
}

forInit { LocalVarDecl | csep1<stmtExpr> }

forIter { csep1<stmtExpr> }


// Foreach statement

ForeachStmt[group=Statement] {
	kw<'await'>? kw<'foreach'> parens<scoped? localVarType varDesignation kw<'in'> expr>
	EmbeddedStmt
}


// Control flow statement

JumpStmt[group=Statement] {
	BreakStmt
	| ContinueStmt
	| GotoStmt
	| ReturnStmt
	| ThrowStmt
}

BreakStmt[group=Statement] { kw<'break'> ';' }

ContinueStmt[group=Statement] { kw<'continue'> ';' }

GotoStmt[group=Statement] {
	kw<'goto'> identifier ';'
	| kw<'goto'> kw<'case'> expr ';'
	| kw<'goto'> kw<'default'> ';'
}

ReturnStmt[group=Statement] { kw<'return'> (ref? expr)? ';' }

ThrowStmt[group=Statement] { kw<'throw'> expr? ';' }


// Try statement

TryStmt[group=Statement] {
	kw<'try'> block catchClauses
	| kw<'try'> block catchClauses? finallyClause
}

catchClauses {
	specificCatchClause+
	| specificCatchClause* generalCatchClause
}

specificCatchClause {
	kw<'catch'> exceptionSpecifier exceptionFilter? block
	| kw<'catch'> exceptionFilter block
}

exceptionSpecifier { parens<type VarName?> }

exceptionFilter { kw<'when'> parens<expr> }

generalCatchClause { kw<'catch'> block }

finallyClause { kw<'finally'> block }


// Checked/Unchecked statement

CheckedStmt[group=Statement] { kw<'checked'> block }

UncheckedStmt[group=Statement] { kw<'unchecked'> block }


// Lock statement

LockStmt[group=Statement] { kw<'lock'> parens<expr> EmbeddedStmt }


// Using statement

UsingStmt[group=Statement] { kw<'using'> parens<resourceAcquisition> EmbeddedStmt }

resourceAcquisition { LocalVarDecl | expr }


// Yield statement

YieldStmt[group=Statement] {
	kw<'yield'> kw<'return'> expr ';'
	| kw<'yield'> kw<'break'> ';'
}


// Unsafe statement

UnsafeStmt[group=Statement] { kw<'unsafe'> block }


// Fixed statement

FixedStmt[group=Statement] {
	kw<'fixed'> parens<type csep1<fixedPtrDeclarator>> EmbeddedStmt
}

fixedPtrDeclarator { identifier '=' expr }


// Compilation unit

compilationUnit {
	externAliasDirective* usingDirective* globalAttrs? TopLevelStmt* NamespaceMemberDecl*
}


// Namespace declaration

NamespaceDecl[group=Declaration] { kw<'namespace'> sep1<TypeIdentifier, '.'> namespaceBody? ';'? }

namespaceBody {
	braces<externAliasDirective* usingDirective* NamespaceMemberDecl*>
}


// Extern alias directive

externAliasDirective { kw<'extern'> kw<'alias'> identifier ';' }


// Using directive

usingDirective {
	kw<'using'> TypeIdentifier '=' namespaceOrTypeName ';'
	| kw<'global'>? kw<'using'> namespaceName ';'
	| kw<'global'>? kw<'using'> kw<'static'> typeName ';'
}


// Namespace member declaration

NamespaceMemberDecl[group=Declaration] { NamespaceDecl | TypeDecl }


// Type declaration

TypeDecl[group=Declaration] {
	ClassDecl
	| ExtensionBlockDecl
	| InterfaceDecl
	| RecordDecl
	| EnumDecl
	| DelegateDecl
	| StructDecl
	| UnionDecl
}


// General

QualifiedAliasMember { TypeIdentifier !typeAccess '::' TypeIdentifier typeArgumentList? }


// Modifiers

modifier {
	kw<'new'>
	| kw<'public'>
	| kw<'protected'>
	| kw<'internal'>
	| kw<'private'>
	| kw<'static'>
	| kw<'virtual'>
	| kw<'sealed'>
	| kw<'override'>
	| kw<'abstract'>
	| kw<'extern'>
	| kw<'unsafe'>
	| kw<'async'>
	| kw<'readonly'>
	| kw<'volatile'>
	| kw<'partial'>
	| kw<'ref'>
	| kw<'required'>
	| kw<'safe'>
	| kw<'file'>
	| kw<'closed'>
}


// Type parameters

typeParamList { chevrons<typeParams> }

typeParams { csep1<(attrs? typeParam)> }

typeParam { TypeIdentifier }


// Type parameter constraints

typeParamConstraintsClause { kw<'where'> typeParam ':' csep1<typeParamConstraints> }

typeParamConstraints {
	allowsConstraintClause
	| classOrStructConstraint
	| ctorConstraint
	| defaultConstraint
	| primaryConstraint
}

allowsConstraintClause { kw<'allows'> csep1<allowsConstraint> }

allowsConstraint { refStructConstraint }

refStructConstraint { kw<'ref'> kw<'struct'> }

classOrStructConstraint {
	kw<'class'> '?'?
	| kw<'struct'> '?'?
}

ctorConstraint { new '(' ')' }

defaultConstraint { kw<'default'> }

primaryConstraint {
	typeName '?'?
	| kw<'notnull'>
	| kw<'unmanaged'>
}


// Class declaration

ClassDecl[group=Declaration] {
	attrs? modifier* kw<'class'>
	TypeIdentifier typeParamList? typeParamConstraintsClause*
	formalParams? classBase?
	(classBody ';'? | ';')
}

classBase { ':' csep1<typeName> arguments? (',' typeName)* }

classBody { braces<ClassMemberDecl*> }

ClassMemberDecl[group=Declaration] {
	ConstantDecl
	| FieldDecl
	| MethodDecl
	| PropertyDecl
	| EventDecl
	| IndexerDecl
	| OperatorDecl
	| CtorDecl
	| FinalizerDecl
	| TypeDecl
}


// Extension Block declaration


ExtensionBlockDecl[group=Declaration] {
	attrs? modifier* kw<'extension'>
	typeParamList? typeParamConstraintsClause*
	formalParams typeParamConstraintsClause*
	extensionBlockBody ';'?
}

extensionBlockBody { braces<ExtensionBlockMemberDecl*> }

ExtensionBlockMemberDecl[group=Declaration] {
	ConstantDecl
	| FieldDecl
	| MethodDecl
	| PropertyDecl
	| EventDecl
	| IndexerDecl
	| OperatorDecl
	| CtorDecl
	| FinalizerDecl
	| TypeDecl
}


// Constant declaration

ConstantDecl[group=Declaration] {
	attrs? modifier* kw<'const'> type csep1<constDeclarator> ';'
}


// Field declaration

FieldDecl[group=Declaration] {
	attrs? modifier* type csep1<varDeclarator> ';'
}


// Method declaration

MethodDecl[group=Declaration] { attrs? modifier* methodHeader typeParamConstraintsClause* methodBody }

// BUGGY!!!!!!!!!!!!!!!!!!!!!!!!!!
// type args get confused with type params
memberTypeNameAccess<end> {
	!typeAccess '.' TypeIdentifier typeArgumentList? memberTypeNameAccess<end>
	| !typeAccess '.' end
}

memberTypeName<end> {
	TypeIdentifier typeArgumentList? memberTypeNameAccess<end>
	| QualifiedAliasMember memberTypeNameAccess<end>
	| end
}

MethodName { identifier ~tid }

methodHeader {
	type memberTypeName<(MethodName typeParamList?)> !params formalParams
}

methodBody {
	block
	| '=>' ref? expr ';'
	| ';'
}


// Parameters

formalParams { parens<formalParamList?> }

formalParamList {
	attrs? paramModifier? (type ParamName? | kw<'__arglist'>) defaultArg? (!comma ',' formalParamList)?
	| attrs? ckw<'params'> arrayType ParamName
}

ParamName { identifier ~id ~tid }

fixedParam {
	attrs? paramModifier? type ParamName defaultArg?
}

defaultArg { !assign '=' expr }

paramModifier {
	paramModeModifier
	| scoped paramModeModifier?
	| kw<'this'> scoped? paramModeModifier?
}

paramModeModifier {
	kw<'ref'>
	| kw<'out'>
	| kw<'in'>
}


// Property declaration

PropertyDecl[group=Declaration] {
	attrs? modifier* type propertyName propertyBody
}

PropertyName { identifier ~tid }

// TODO: fix `type A.B()` parsing `A.B` as full type
propertyName { memberTypeName<PropertyName> }

propertyBody {
	braces<accessorDecls> propertyInit?
	| '=>' ref? expr ';'
}

propertyInit { '=' varInit ';' }

accessorDecls {
	GetAccessorDecl SetAccessorDecl?
	| SetAccessorDecl GetAccessorDecl?
}

GetAccessorDecl[group=Declaration] { attrs? accessorModifier? kw<'get'> accessorBody }

SetAccessorDecl[group=Declaration] { attrs? accessorModifier? (kw<'set'> | kw<'init'>) accessorBody }

accessorModifier {
	kw<'protected'>
	| kw<'internal'>
	| kw<'private'>
	| kw<'protected'> kw<'internal'>
	| kw<'internal'> kw<'protected'>
	| kw<'protected'> kw<'private'>
	| kw<'private'> kw<'protected'>
}

accessorBody {
	block
	| '=>' ref? expr ';'
	| ';'
}


// Event declaration

EventDecl[group=Declaration] {
	attrs? modifier* kw<'event'> type
	( csep1<varDeclarator>
	| memberTypeName<PropertyName> braces<eventAccessorDecls>
	)
}

eventAccessorDecls {
	AddAccessorDecl RemoveAccessorDecl
	| RemoveAccessorDecl AddAccessorDecl
}

AddAccessorDecl[group=Declaration] { attrs? ckw<'add'> block }

RemoveAccessorDecl[group=Declaration] { attrs? ckw<'remove'> block }


// Indexer declaration

IndexerDecl[group=Declaration] {
	attrs? modifier* indexerDeclarator indexerBody
}

indexerDeclarator { type memberTypeName<kw<'this'>> brackets<formalParamList> }

indexerBody {
	braces<accessorDecls>
	| '=>' ref? expr ';'
}


// Operator declaration

OperatorDecl[group=Declaration] {
	attrs? modifier+ operatorDeclarator operatorBody
}

operatorDeclarator {
	unaryOpDeclarator
	| binaryOpDeclarator
	| conversionOpDeclarator
}

unaryOpDeclarator {
	type kw<'operator'>
	( '+' | '-' | '!' | '~' | '++' | '--' | BooleanLiteral )
	parens<fixedParam>
}

binaryOpDeclarator {
	type kw<'operator'>
	( '+' | '-' | '*' | '/' | '%' | '&' | '|' | '^' | '<<'
	| RightShift | '==' | '!=' | '>' | '<' | '>=' | '<='
	)
	parens<fixedParam ',' fixedParam>
}

conversionOpDeclarator {
	(kw<'implicit'> | kw<'explicit'>) kw<'operator'> type
	parens<fixedParam>
}

operatorBody {
	block
	| '=>' ref? expr ';'
	| ';'
}


// Constructor declaration

CtorDecl[group=Declaration] {
	attrs? modifier* ctorDeclarator ctorBody
}

ctorDeclarator {
	 TypeIdentifier formalParams ctorInit
 }

ctorInit { ':' (kw<'base'> | kw<'this'>) arguments }

ctorBody {
	block
	| '=>' expr ';'
	| ';'
}


// Finalizer declaration

FinalizerDecl[group=Declaration] {
	attrs? modifier* '~' TypeIdentifier '(' ')' finalizerBody
}

finalizerBody {
	block
	| '=>' expr ';'
	| ';'
}


// Struct declaration

StructDecl[group=Declaration] {
	attrs? modifier* kw<'struct'>
	TypeIdentifier typeParamList? typeParamConstraintsClause*
	formalParams? classBase?
	(structBody ';'? | ';')
}

structBody { braces<StructMemberDecl*> }

StructMemberDecl[group=Declaration] {
	ConstantDecl
	| FieldDecl
	| MethodDecl
	| PropertyDecl
	| EventDecl
	| IndexerDecl
	| OperatorDecl
	| CtorDecl
	| TypeDecl
	| FixedSizeBufferDecl
}

// Union declaration

UnionDecl[group=Declaration] {
	attrs? modifier* kw<'union'>
	TypeIdentifier typeParamList? typeParamConstraintsClause*
	formalParams? classBase?
	(classBody ';'? | ';')
}

// Array initializer

arrayInit {
	braces<varInitList?>
	| braces<varInitList ','>
}

varInitList { csep1<(expr | arrayInit)> }


// Stackalloc initializer

stackallocInit {
	kw<'stackalloc'> nonArrayType brackets<expr>
	| kw<'stackalloc'> brackets<expr?> braces<csep1<expr>>
}


// Interface declaration

InterfaceDecl[group=Declaration] {
	attrs? modifier* kw<'interface'>
	TypeIdentifier variantTypeParamList? typeParamConstraintsClause*
	formalParams? classBase?
	(interfaceBody ';'? | ';')
}

variantTypeParamList { chevrons<csep1<variantTypeParam>> }

variantTypeParam { attrs? varianceAnnotation? typeParam }

varianceAnnotation { kw<'in'> | kw<'out'> }

interfaceBody { braces<InterfaceMemberDecl*> }

InterfaceMemberDecl[group=Declaration] {
	InterfaceMethodDecl
	| InterfacePropertyDecl
	| InterfaceEventDecl
	| InterfaceIndexerDecl
}


// Interface method declaration

InterfaceMethodDecl[group=Declaration] {
	attrs? new? type MethodName typeParamList?
	formalParams typeParamConstraintsClause* ';'
}


// Interface property declaration

InterfacePropertyDecl[group=Declaration] {
	attrs? new? type PropertyName braces<interfaceAccessors>
}

interfaceAccessors {
	attrs? kw<'get'> ';'
	| attrs? kw<'set'> ';'
	| attrs? kw<'get'> ';' attrs? kw<'set'> ';'
	| attrs? kw<'set'> ';' attrs? kw<'get'> ';'
}


// Interface event declaration

InterfaceEventDecl[group=Declaration] {
	attrs? new? kw<'event'> type MethodName ';'
}


// Interface indexer declaration

InterfaceIndexerDecl[group=Declaration] {
	attrs? new? type kw<'this'> brackets<formalParamList>
	braces<interfaceAccessors>
}


// Record declaration

RecordDecl[group=Declaration] {
	attrs? modifier* kw<'record'> kw<'struct'>?
	TypeIdentifier typeParamList? typeParamConstraintsClause*
	formalParams? recordBase?
	(classBody ';'? | ';')
}

recordBase {
	':' typeName arguments? (',' typeName)*
}


// Enum declaration

EnumDecl[group=Declaration] {
	attrs? modifier* kw<'enum'> TypeIdentifier enumBase?
	(enumBody ';'? | ';')
}

enumBase { ':' (SimpleType | typeName) }

enumBody {
	braces<(EnumMemberDecl (',' EnumMemberDecl)* ','?)?>
}

EnumMemberDecl[group=Declaration] {
	attrs? ConstName ('=' expr)?
}


// Delegate declaration

DelegateDecl[group=Declaration] {
	attrs? modifier* kw<'delegate'> type TypeIdentifier
	variantTypeParamList? formalParams typeParamConstraintsClause*
	';'
}


// Fixed-size buffer declaration

FixedSizeBufferDecl[group=Declaration] {
	attrs? modifier* kw<'fixed'> type
	csep1<fixedSizeBufferDeclarator> ';'
}

fixedSizeBufferDeclarator { identifier brackets<expr> }


// Attributes

globalAttrs { globalAttrSection+ }

globalAttrSection {
	brackets<globalAttrTargetSpecifier csep1<attr> ','?>
}

globalAttrTargetSpecifier { globalAttrTarget ':' }

globalAttrTarget { kw<'assembly'> | kw<'module'> }

attrs { attrSection+ }

attrSection {
	brackets<attrTargetSpecifier? csep1<attr> ','?>
}

attrTargetSpecifier { attrTarget ':' }

attrTarget { identifier }

attr { typeName attrArgs? }

attrArgs { parens<attrArgListPos?> }

attrArgListPos {
	ArgumentName nonAssignmentExpr (!comma ',' attrArgListPos)?
	| nonAssignmentExpr (!comma ',' attrArgListPos)?
	| AttrsNamedArg !assign '=' nonAssignmentExpr (!comma ',' attrArgListNamed)
}

attrArgListNamed {
	AttrsNamedArg !assign '=' nonAssignmentExpr (!comma ',' attrArgListNamed)
}

AttrsNamedArg[@dynamicPrecedence=1] { identifier ~id }


// Util

kw<word> { @specialize[@name=Keyword]<identifier, word> }

ckw<word> { @extend[@name=ContextualKeyword]<identifier, word> }

delim<contents, name> { delim[@name={name}, group=Delim] { contents } }

braces<contents> { delim<'{' contents '}', 'BracesDelim'> }

brackets<contents> { delim<'[' contents ']', 'BracketsDelim'> }

parens<contents> { delim<'(' contents ')', 'ParensDelim'> }

chevrons<contents> { delim<'<' contents '>', 'ChevronsDelim'> }

sep1<rule, by> { rule (by rule)* }

//sep0<rule, by> { sep1<rule, by>? }

csep1<rule> { sep1<rule, !comma ','> }

csep0<rule> { csep1<rule>? }
